# Cloudflare Worker secrets — set via: wrangler secret put <NAME>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
N8N_SHARED_SECRET=

# Cloudflare Worker vars — set in wrangler.toml (non-secret)
# STATE_KEY=drive_watch_state
# INTAKE_FOLDER_ID=<teacher Google Drive folder ID>
# N8N_WEBHOOK_URL=<WF1 production webhook URL>

# n8n WF1 → WF2 shared secret (store as n8n credential or env var)
WF2_SHARED_SECRET=

# Supabase (n8n credential)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (n8n credential)
OPENAI_API_KEY=
