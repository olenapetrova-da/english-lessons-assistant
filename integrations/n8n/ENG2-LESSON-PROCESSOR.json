          "value": "gpt-4o-mini",
          "mode": "list"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are an assistant that analyses English lesson notes. Extract structured data from the lesson text provided and return ONLY valid JSON with this exact shape:\n{\n  \"topic\": \"string — main topic of the lesson\",\n  \"lesson_date\": \"YYYY-MM-DD or null\",\n  \"vocabulary\": [\n    { \"word\": \"string\", \"definition\": \"string\", \"example\": \"string or null\" }\n  ],\n  \"homework\": [\n    { \"description\": \"string\", \"due_date\": \"YYYY-MM-DD or null\" }\n  ]\n}\nIf a field is not mentioned in the text, use null or an empty array. Return only JSON, no markdown fences."
            },
            {
              "role": "user",
              "content": "={{ $node[\"Google Drive: export doc as text\"].json.data }}"
            }
          ]
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [540, 300],
      "id": "openai_extract",
      "name": "OpenAI: extract lesson data",
      "credentials": {
        "openAiApi": {
          "id": "__OPENAI_CREDENTIAL_ID__",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.message.content;\nconst parsed = JSON.parse(raw);\nconst fileId = $node[\"Webhook from WF1\"].json.body.fileId;\nreturn [{ json: { ...parsed, fileId, webViewLink: $node[\"Webhook from WF1\"].json.body.webViewLink } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [800, 300],
      "id": "code_parse",
      "name": "Parse GPT response"
    },
    {
      "parameters": {
        "operation": "create",
        "tableId": "lessons",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "file_id",     "fieldValue": "={{ $json.fileId }}" },
            { "fieldId": "topic",       "fieldValue": "={{ $json.topic }}" },
            { "fieldId": "lesson_date", "fieldValue": "={{ $json.lesson_date }}" },
            { "fieldId": "doc_url",     "fieldValue": "={{ $json.webViewLink }}" },
            { "fieldId": "raw_text",    "fieldValue": "={{ $node[\"Google Drive: export doc as text\"].json.data }}" }
          ]
        }
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1060, 300],
      "id": "supabase_insert_lesson",
      "name": "Supabase: insert lesson",
      "credentials": {
        "supabaseApi": {
          "id": "__SUPABASE_CREDENTIAL_ID__",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const lessonId = $input.first().json.id;\nconst vocab = $node[\"Parse GPT response\"].json.vocabulary || [];\nreturn vocab.map(v => ({ json: { lesson_id: lessonId, word: v.word, definition: v.definition || null, example: v.example || null } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 200],
      "id": "code_vocab_rows",
      "name": "Build vocabulary rows"
    },
    {
      "parameters": {
        "jsCode": "const lessonId = $node[\"Supabase: insert lesson\"].json.id;\nconst hw = $node[\"Parse GPT response\"].json.homework || [];\nreturn hw.map(h => ({ json: { lesson_id: lessonId, description: h.description, due_date: h.due_date || null } }));"
      },
      "type": "n8n-nodes-base.code",
